# Copie este archivo como .env.local y complete los valores. .env.local nunca se sube al repositorio.
# En GitHub Actions, estas mismas variables se definen como "variables del repositorio".
# Especificación §14.3.

# URL pública del sitio, sin barra final.
# Hasta la Fase 7: https://oscarnarvaez.github.io/pg_web_riascos_Barrera
# Con dominio propio: https://riascosbarrera.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ruta base. Vacía en local y con dominio propio; "/pg_web_riascos_Barrera" en github.io.
# En GitHub Actions no se configura: se deriva de NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_BASE_PATH=

# Supabase. La clave anon/publishable es pública por diseño; la seguridad depende de RLS.
# La clave service role NUNCA va aquí: solo en los secretos de las Edge Functions.
NEXT_PUBLIC_SUPABASE_URL=https://duhmgtjnlvwfgvdoqngz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave pública de Cloudflare Turnstile (la secreta va en las Edge Functions).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Tag Manager. Vacío: no se carga nada.
NEXT_PUBLIC_GTM_ID=
# true: GTM solo se carga después de aceptar el aviso de cookies.
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=true

# Número de WhatsApp institucional en formato internacional sin "+" (por ejemplo 57300...).
# Vacío: el botón no se muestra.
NEXT_PUBLIC_WHATSAPP=

# false: la página de Equipo no se genera y desaparece del menú y del sitemap.
NEXT_PUBLIC_EQUIPO_ACTIVO=true

# true: la compilación de producción continúa aunque haya páginas obligatorias pendientes.
# Activada durante las Fases 1–6; se retira en la Fase 7 (§14.4).
PERMITIR_PENDIENTES=false
